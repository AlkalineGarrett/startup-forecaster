{
  "name": "montecarlo-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "MC_CONFIG=examples MC_N=500 node --test --test-reporter=spec $(ls test/*.test.ts | grep -v example.test.ts) && MC_CONFIG=examples node --test --test-reporter=spec test/example.test.ts",
    "test:full": "MC_CONFIG=examples node --test --test-reporter=spec test/*.test.ts",
    "coverage": "MC_CONFIG=examples/portfolio.config.mjs node --experimental-strip-types coverage.mjs",
    "simulate": "MC_CONFIG=examples/portfolio.config.mjs node simulation/run.mjs",
    "regen:example-golden": "MC_CONFIG=examples/portfolio.config.mjs node --experimental-strip-types simulation/golden.mjs"
  }
}
